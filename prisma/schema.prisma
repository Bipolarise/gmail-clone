generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]

  // Gmail relations
  gmailThreads  GmailThread[]
  gmailMessages GmailMessage[]
}

model Account {
  id                        String   @id @default(cuid())
  userId                    String
  type                      String
  provider                  String
  providerAccountId         String
  refresh_token             String?  @db.Text
  access_token              String?  @db.Text
  expires_at                Int?
  token_type                String?
  scope                     String?
  id_token                  String?  @db.Text
  session_state             String?
  refresh_token_expires_in  Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

//
// Gmail models
//

model GmailThread {
  /// Gmail threadId
  id        String   @id
  userId    String
  subject   String?
  snippet   String?
  updatedAt DateTime?

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  GmailMessage[]
}

model GmailMessage {
  /// Gmail messageId
  id           String   @id
  threadId     String
  userId       String
  from         String?
  to           String?
  subject      String?
  snippet      String?
  internalDate DateTime?
  s3Key        String?      // key/path of HTML body in S3
  labelIds     String[]     // Gmail label IDs (e.g. ["INBOX","UNREAD"])

  thread       GmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}
